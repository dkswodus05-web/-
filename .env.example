# ===== Alpaca 모의투자(Paper) API 키 =====
# 발급: https://app.alpaca.markets/ 가입 → 우상단에서 'Paper' 계정 선택 → API Keys 생성
ALPACA_API_KEY=여기에_페이퍼_API_키
ALPACA_SECRET_KEY=여기에_페이퍼_시크릿_키

# ===== FRED 경제데이터 API 키 (무료) =====
# 거시지표(금리·실업률·CPI 등) 공식 수집용. 없으면 fred_collector가 안전 정지(가짜값 X).
# 발급: https://fred.stlouisfed.org/docs/api/api_key.html (가입 후 즉시 무료 발급)
FRED_API_KEY=여기에_FRED_API_키

# ===== Anthropic API 키 (AI 투자위원회용, daily_pipeline.py 전용) =====
# 없으면 AI 위원회 호출 불가 → 안전 정지(매매 안 함). Claude 앱과는 별개의 키입니다.
# 발급: https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=여기에_Anthropic_API_키
# 필요시 모델 교체 (기본값 권장)
ANTHROPIC_MODEL=claude-sonnet-5

# true면 실제 주문을 넣지 않고 시뮬레이션 로그만 출력 (안전 기본값).
# 실제 모의주문을 Alpaca에 보내 테스트할 때만 false 로 변경.
DRY_RUN=true

# 매매할 ETF: SPY 또는 QQQ
ACTIVE_SYMBOL=SPY
